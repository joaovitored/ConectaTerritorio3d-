# Copie para .env e ajuste. O .env NÃO vai para o Git.
DJANGO_DEBUG=1
# Obrigatória quando DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=conecta_territorio
POSTGRES_USER=conecta_user
POSTGRES_PASSWORD=conecta_dev_123
# Dentro do Docker o host é "db" e a porta 5432 (o compose já define isso)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

IMPORT_MAX_UPLOAD_MB=50
LOG_LEVEL=INFO
